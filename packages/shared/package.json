{
  "name": "@app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./media": { "types": "./dist/media.d.ts", "default": "./dist/media.js" }
  },
  "scripts": {
    "generate": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": { "typescript": "^6.0.2", "@types/node": "^24.0.0" }
}
